{
  "id": "npa.ui.tools.core",
  "name": "Core NPA UI Tools",
  "version": "1.0.0",
  "plugin": "plugin.js",
  "requires": [
  	{"type": "plugin","id": "npa.core","version": "1.0.0"},
  	{"type": "plugin","id": "npa.logging","version": "1.0.0"},
  	{"type": "plugin","id": "npa.http","version": "1.0.0"},
  	{"type": "plugin","id": "npa.ui.locale","version": "1.0.0"},
  	{"type": "plugin","id": "npa.documentation","version": "1.0.0"}
  ],
  "extends": [
  	{
  		"point": "npa.log.provider",
  		"id": "npa.ui.tools.core.logger",
  		"dir": "npa.ui.tools.core"
  	},
  	{
  		"point": "npa.http.router",
  		"id": "npa.ui.tools.core.router",
  		"path": "/uiToolsApis"
  	},
  	{
  		"point": "npa.http.ws.router",
  		"id": "npa.ui.tools.core.ws.router",
  		"path": "/npaUi"
  	},
  	{
  		"point": "npa.http.static",
  		"id": "npa.ui.tools.core.htdocs",
  		"path": "/uiTools",
  		"localDir": "htdocs"
  	},
  	{
  		"point": "npa.http.handler",
  		"id": "npa.ui.tools.core.getMap.handler",
  		"router": "npa.ui.tools.core.router",
  		"method": "GET",
  		"schema": "/getComponentMap",
  		"handler": "getComponentMapHandler",
		"description": "Get the Map of registered UI components within the NPA-Utils framework",
		"input": ""
  	},
  	{
  		"point": "npa.ui.locale.provider",
  		"id": "npa.ui.tools.core.locale.provider.enUS",
  		"path": "i18n/npaComponents_en_US.locale",
  		"locale": "en-US"
  	},
  	{
  		"point": "npa.ui.locale.provider",
  		"id": "npa.ui.tools.core.locale.provider.en",
  		"path": "i18n/npaComponents_en_US.locale",
  		"locale": "en"
  	},
  	{
  		"point": "npa.ui.locale.provider",
  		"id": "npa.ui.tools.core.locale.provider.frFR",
  		"path": "i18n/npaComponents_fr_FR.locale",
  		"locale": "fr-FR"
  	},
  	{
  		"point": "npa.ui.locale.provider",
  		"id": "npa.ui.tools.core.locale.provider.fr",
  		"path": "i18n/npaComponents_fr_FR.locale",
  		"locale": "fr"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.framework.doc",
  		"label": "npa.ui.tools.core - npaUi Framework",
  		"category": "NPA UI Tools",
  		"subcategory": "Framework",
  		"url": "/uiTools/docs/npaUiFramework.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.card.doc",
  		"label": "Card",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiCard.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.navbar.doc",
  		"label": "NavBar",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiNavBar.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.notifier.doc",
  		"label": "Notifier",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiNotifier.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.datatable.doc",
  		"label": "Datatable",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiDatatable.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.toolbar.doc",
  		"label": "Toolbar",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiToolbar.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.form.doc",
  		"label": "Form",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiForm.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.splitter.doc",
  		"label": "Splitter",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiSplitter.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.modal.doc",
  		"label": "ModalDialog",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiModalDialog.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.panel.doc",
  		"label": "Panel",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiPanel.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.console.doc",
  		"label": "Console",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiConsole.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.tabpane.doc",
  		"label": "TabPane",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiTabPane.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.selectionlist.doc",
  		"label": "SelectionList",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiSelectionList.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.accordion.doc",
  		"label": "Accordion",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiAccordion.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.carousel.doc",
  		"label": "Carousel",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiCarousel.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.verticalmenu.doc",
  		"label": "VerticalMenu",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiVerticalMenu.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.htmlimport.doc",
  		"label": "HtmlImport",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiHtmlImport.html"
  	},
  	{
  		"point": "npa.documentation.page",
  		"id": "npa.ui.tools.core.dynamicactionloader.doc",
  		"label": "DynamicActionLoader",
  		"category": "NPA UI Tools",
  		"subcategory": "Components",
  		"url": "/uiTools/docs/components/npaUiDynamicActionLoader.html"
  	},
  	{
  		"point": "npa.http.handler",
  		"id": "npa.ui.tools.core.editors.handler",
  		"router": "npa.ui.tools.core.router",
  		"method": "GET",
  		"schema": "/editors",
  		"handler": "getEditorExtensionsHandler",
		"description": "Get the list of registered Editors within the NPA-Utils framework",
		"input": ""
  	},
  	{
  		"point": "npa.http.ws.handler",
  		"id": "npa.ui.tools.core.ws.handler",
  		"router": "npa.ui.tools.core.ws.router",
  		"schema": "/ws",
  		"handler": "wsMessageHandler",
  		"securityRole": "operator",
		"description": "WebSocket message handler for npaUi components"
  	}
  ],
  "provides": [
  	{"id": "npa.ui.tools.core.component"},
  	{"id": "npa.ui.tools.core.editor"}
  ]
}